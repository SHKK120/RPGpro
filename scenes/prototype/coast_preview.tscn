[sub_resource type="Shader" id="Shader_sea"]
code = "shader_type spatial;\nrender_mode cull_disabled;\n\nuniform vec3 deep_color : source_color = vec3(0.035, 0.22, 0.34);\nuniform vec3 crest_color : source_color = vec3(0.12, 0.48, 0.58);\n\nvoid vertex() {\n\tfloat wave_a = sin(VERTEX.x * 0.32 + TIME * 0.72);\n\tfloat wave_b = cos(VERTEX.z * 0.38 + TIME * 0.55);\n\tVERTEX.y += (wave_a + wave_b) * 0.075;\n}\n\nvoid fragment() {\n\tfloat band = clamp(NORMAL.y * 0.55 + 0.35, 0.0, 1.0);\n\tALBEDO = mix(deep_color, crest_color, band);\n\tROUGHNESS = 0.42;\n\tMETALLIC = 0.05;\n}\n"

